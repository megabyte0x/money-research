{
  "name": "money-research",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-content.mjs",
    "dev": "vite",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:build": "node --test tests/static-output.test.mjs",
    "build": "node scripts/build-content.mjs && vite build && node scripts/prerender.mjs",
    "test:release": "npm run build && npm test",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
